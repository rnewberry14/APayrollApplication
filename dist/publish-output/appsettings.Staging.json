{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=ClearPathPayroll.Staging;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "TaxApi": {
    "BaseUrl": "https://staging-tax.example.com",
    "ApiKey": "ENTER_STAGING_TAX_API_KEY",
    "SandboxMode": true
  },
  "ACHApi": {
    "BaseUrl": "https://staging-ach.example.com",
    "ApiKey": "ENTER_STAGING_ACH_API_KEY",
    "SandboxMode": true,
    "AllowProductionSubmission": false
  },
  "BankVerification": {
    "Provider": "ExampleBankVerify",
    "BaseUrl": "https://staging-bankverify.example.com",
    "ApiKey": "ENTER_STAGING_BANK_VERIFICATION_API_KEY"
  },
  "Encryption": {
    "KeyVaultUri": "https://your-staging-key-vault.vault.azure.net/",
    "KeyVaultKeyName": "staging-encryption-key"
  },
  "Authentication": {
    "Authority": "https://login.microsoftonline.com/your-tenant-id"
  },
  "Email": {
    "Provider": "smtp",
    "FromAddress": "no-reply@clearpathpayroll.local",
    "ApiKey": "ENTER_STAGING_EMAIL_API_KEY"
  },
  "AzureKeyVault": {
    "Enabled": true,
    "VaultUri": "https://your-staging-key-vault.vault.azure.net/"
  },
  "AzureStorage": {
    "ConnectionString": "ENTER_STAGING_AZURE_STORAGE_CONNECTION_STRING"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
