            </NavLink>
        </div>

        <!-- Setup Section -->
        <div class="nav-item px-3">
            <div class="nav-link" style="cursor: pointer; padding: 0.5rem 0.75rem; color: #d7d7d7; font-weight: 600; margin-top: 0.5rem;">
                <span class="bi bi-gear-fill-nav-menu" aria-hidden="true"></span> Setup
            </div>
            <nav class="flex-column ms-3">
                <div class="nav-item px-0">
