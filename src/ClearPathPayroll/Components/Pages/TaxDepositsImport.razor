@page "/import/tax-deposits"
@page "/imports/tax-deposits"
@using ClearPathPayroll.Services
@inject TaxDepositsImportService DepositImportService

<PageTitle>Tax Deposits Import - ClearPath Payroll</PageTitle>

<div class="container-fluid mt-4">
    <NoAdviceDisclaimer />

    <div class="alert alert-success" role="status">
        <strong>Local import:</strong> Tax deposit files are parsed locally and saved only after confirmation. This workflow does not submit payments, file taxes, or call IRS/state systems.
    </div>

    <div class="alert alert-warning" role="alert">
        Imported deposits are shown as “User-entered deposit record” entries. ClearPath Payroll does not claim imported deposit records are verified.
    </div>

    <div class="card mb-4">
        <div class="card-header bg-light">Tax Deposit Columns</div>
        <div class="card-body">
            <p class="mb-2"><strong>Required:</strong> CompanyIdentifier, DepositDate, TaxPeriodStart, TaxPeriodEnd, TaxType, Agency, Amount, PaymentMethod.</p>
            <p class="mb-0"><strong>Optional:</strong> ConfirmationNumber, Notes.</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-lg-8">
            <h2>Tax Deposits Import</h2>
            <p class="text-muted">Import historical user-entered deposit records for local review and reporting.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @statusClass" role="status">@statusMessage</div>
    }

    <ImportProgress Progress="progress" />

    <div class="card mb-4">
        <div class="card-header bg-light">1. Select Local File</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-7">
                    <label class="form-label" for="depositFile">Tax deposit file</label>
                    <InputFile id="depositFile" class="form-control" OnChange="OnFileSelected" />
                    <div class="form-text">Accepted formats: .csv, .txt, .tsv, .tab, and first worksheet of .xlsx.</div>
                </div>
                <div class="col-md-5">
                    <label class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" @bind="reviewAcknowledged" />
                        Review warning acknowledged
                    </label>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(selectedFileName))
            {
                <div class="small text-muted mt-3">Selected file: @selectedFileName</div>
            }
        </div>
    </div>

    @if (parseResult != null)
    {
        <ImportMappingPanel Title="2. Map Columns"
                            Mappings="mappingInputs"
                            TargetFields="TaxDepositsImportService.AllTargetFields"
                            RequiredTargetFields="TaxDepositsImportService.RequiredTargetFields"
                            IsWorking="isWorking"
                            ValidateButtonText="Validate Tax Deposits"
                            OnValidate="ValidateDeposits" />

        <div class="card mb-4">
            <div class="card-header bg-light">3. Preview Before Saving</div>
            <div class="table-responsive">
                <table class="table table-striped table-sm mb-0">
                    <thead>
                        <tr>
                            @foreach (var column in parseResult.Columns)
                            {
                                <th>@column</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in parseResult.Rows.Take(15))
                        {
                            <tr>
                                @foreach (var column in parseResult.Columns)
                                {
                                    <td>@GetCell(row, column)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer small text-muted">Preview shows up to 15 rows. Records are saved only after confirmation.</div>
        </div>
    }

    @if (validationResult != null)
    {
        <div class="card mb-4">
            <div class="card-header bg-light">4. Validation Results</div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Batch</dt>
                    <dd class="col-sm-9">#@validationResult.Batch.ImportBatchId</dd>
                    <dt class="col-sm-3">Rows</dt>
                    <dd class="col-sm-9">@validationResult.Batch.RowCount total, @validationResult.Batch.ValidRowCount valid, @validationResult.Batch.ErrorCount errors</dd>
                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">@validationResult.Batch.Status</dd>
                </dl>

                @if (validationResult.Batch.Errors.Any())
                {
                    <div class="alert alert-danger">Validation errors require review before saving tax deposit records.</div>
                    <ul>
                        @foreach (var error in validationResult.Batch.Errors.OrderBy(error => error.RowNumber).ThenBy(error => error.ErrorCode).Take(50))
                        {
                            <li>Row @(error.RowNumber?.ToString() ?? "batch"): @ImportFieldAliasMatcher.SanitizeErrorMessage(error.Message)</li>
                        }
                    </ul>
                }
                else
                {
                    <div class="alert alert-success">Validation completed. Tax deposit records are ready to save locally.</div>
                    <button class="btn btn-success" @onclick="ConfirmDeposits" disabled="@(isWorking || progress.IsWorking)">Save User-Entered Deposit Records</button>
                }
            </div>
        </div>
    }
</div>

@code {
    private ImportFileParseResult? parseResult;
    private TaxDepositsImportValidationResult? validationResult;
    private List<ImportMappingInput> mappingInputs = new();
    private string selectedFileName = string.Empty;
    private string statusMessage = string.Empty;
    private string statusClass = "alert-info";
    private bool reviewAcknowledged;
    private bool isWorking;
    private ImportProgressModel progress = new();

    private async Task OnFileSelected(InputFileChangeEventArgs args)
    {
        ResetStatus();
        validationResult = null;
        selectedFileName = args.File.Name;

        try
        {
            isWorking = true;
            progress.MoveTo(ImportProgressStage.ReadingFile, "Reading the selected tax deposit file.");
            await using var stream = args.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            progress.MoveTo(ImportProgressStage.ParsingRows, "Parsing tax deposit rows locally.");
            parseResult = await DepositImportService.ParseFileAsync(stream, args.File.Name);
            progress.MoveTo(ImportProgressStage.DetectingColumns, "Detecting tax deposit columns.", parseResult.Rows.Count, parseResult.Warnings.Count, 0);
            mappingInputs = parseResult.Columns.Select(column =>
            {
                var target = ImportFieldAliasMatcher.SuggestTargetField(column, TaxDepositsImportService.AllTargetFields);
                return new ImportMappingInput
                {
                    SourceColumn = column,
                    TargetField = target,
                    IsRequired = TaxDepositsImportService.RequiredTargetFields.Contains(target, StringComparer.OrdinalIgnoreCase)
                };
            }).ToList();
            progress.MoveTo(ImportProgressStage.MappingColumns, "Review suggested tax deposit mappings.", parseResult.Rows.Count, parseResult.Warnings.Count, 0);
            statusClass = "alert-success";
            statusMessage = "Tax deposit file parsed locally. Review mappings and preview before validation.";
        }
        catch (Exception ex)
        {
            parseResult = null;
            mappingInputs.Clear();
            statusClass = "alert-danger";
            statusMessage = $"Unable to parse tax deposit file: {ImportFieldAliasMatcher.SanitizeErrorMessage(ex.Message)}";
            progress.MoveTo(ImportProgressStage.Failed, "The tax deposit file could not be parsed locally.", errorCount: 1);
        }
        finally
        {
            isWorking = false;
        }
    }

    private async Task ValidateDeposits()
    {
        if (parseResult == null)
        {
            return;
        }

        ResetStatus();

        try
        {
            isWorking = true;
            progress.MoveTo(ImportProgressStage.ValidatingRows, "Validating tax deposit rows locally.", parseResult.Rows.Count);
            validationResult = await DepositImportService.ValidateAsync(
                selectedFileName,
                parseResult,
                mappingInputs,
                reviewAcknowledged);
            statusClass = validationResult.CanImport ? "alert-success" : "alert-warning";
            statusMessage = validationResult.CanImport
                ? "Tax deposits validated locally. Save records after review."
                : "Tax deposit validation found blocking errors.";
            progress.MoveTo(validationResult.CanImport ? ImportProgressStage.PreviewReady : ImportProgressStage.Failed,
                validationResult.CanImport ? "Preview is ready for final review." : "Validation found tax deposit errors.",
                validationResult.Batch.RowCount,
                0,
                validationResult.Batch.ErrorCount);
        }
        catch (Exception ex)
        {
            statusClass = "alert-danger";
            statusMessage = $"Unable to validate tax deposits: {ImportFieldAliasMatcher.SanitizeErrorMessage(ex.Message)}";
            progress.MoveTo(ImportProgressStage.Failed, "Tax deposit validation failed with a safe summary message.", errorCount: 1);
        }
        finally
        {
            isWorking = false;
        }
    }

    private async Task ConfirmDeposits()
    {
        if (validationResult == null)
        {
            return;
        }

        ResetStatus();

        try
        {
            isWorking = true;
            progress.MoveTo(ImportProgressStage.SavingImport, "Saving user-entered deposit records locally.", validationResult.Batch.RowCount, 0, validationResult.Batch.ErrorCount);
            var result = await DepositImportService.ConfirmAsync(validationResult.Batch.ImportBatchId);
            validationResult = new TaxDepositsImportValidationResult { Batch = result.Batch };
            statusClass = "alert-success";
            statusMessage = $"{result.ImportedDepositCount} user-entered deposit record(s) saved locally.";
            progress.MoveTo(ImportProgressStage.Complete, "Tax deposit import saved locally.", result.Batch.RowCount, 0, 0);
        }
        catch (Exception ex)
        {
            statusClass = "alert-danger";
            statusMessage = $"Unable to save tax deposit records: {ImportFieldAliasMatcher.SanitizeErrorMessage(ex.Message)}";
            progress.MoveTo(ImportProgressStage.Failed, "Saving tax deposit import failed.", errorCount: 1);
        }
        finally
        {
            isWorking = false;
        }
    }

    private static string GetCell(Dictionary<string, string> row, string column)
    {
        return row.TryGetValue(column, out var value) ? value : string.Empty;
    }

    private void ResetStatus()
    {
        statusMessage = string.Empty;
        statusClass = "alert-info";
    }
}
