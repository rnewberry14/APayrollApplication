@page "/import/employees"
@page "/imports/employees"
@using ClearPathPayroll.Domain
@using ClearPathPayroll.Services
@inject CompanyService CompanyService
@inject EmployeesOnlyImportService EmployeeImportService

<PageTitle>Employees Only Import - ClearPath Payroll</PageTitle>

<div class="container-fluid mt-4">
    <NoAdviceDisclaimer />

    <div class="alert alert-success" role="status">
        <strong>Local import:</strong> Employee files are parsed locally and saved only to the local database after validation and confirmation. No cloud upload, ACH submission, or tax filing is performed.
    </div>

    <div class="alert alert-warning" role="alert">
        Do not import full SSNs, full bank account numbers, or routing numbers. Use SSN last four and direct deposit last four only.
    </div>

    <div class="card mb-4">
        <div class="card-header bg-light">Accepted Employee Columns</div>
        <div class="card-body">
            <p class="mb-2"><strong>Required:</strong> PayType, SSNLast4 or EmployeeNumber, and employee name.</p>
            <p class="mb-2"><strong>Name mapping:</strong> Map either First Name and Last Name, or map Full Name.</p>
            <p class="mb-0">
                <strong>Optional:</strong>
                FullName, FirstName, LastName, MiddleInitial, Address1, Address2, City, State, ZipCode, Email, Phone, HireDate, EmploymentStatus,
                HourlyRate, AnnualSalary, FederalFilingStatus, ExtraWithholding, StateTaxState, StateFilingStatus, DirectDepositLast4.
            </p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-lg-8">
            <h2>Employees Only Import</h2>
            <p class="text-muted">Import employee setup records from CSV, tab-delimited text, or the first worksheet of an .xlsx file.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @statusClass" role="status">@statusMessage</div>
    }

    <ImportProgress Progress="progress" />

    <div class="card mb-4">
        <div class="card-header bg-light">1. Select Company And File</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" for="company">Company</label>
                    <select id="company" class="form-select" @bind="selectedCompanyId">
                        <option value="0">Select a company</option>
                        @foreach (var company in companies)
                        {
                            <option value="@company.CompanyId">@company.LegalName</option>
                        }
                    </select>
                </div>
                <div class="col-md-5">
                    <label class="form-label" for="employeeFile">Employee file</label>
                    <InputFile id="employeeFile" class="form-control" OnChange="OnFileSelected" />
                    <div class="form-text">Accepted formats: .csv, .txt, .tsv, .tab, and .xlsx.</div>
                </div>
                <div class="col-md-3">
                    <label class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" @bind="demoWarningAcknowledged" />
                        Demo warning reviewed
                    </label>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(selectedFileName))
            {
                <div class="small text-muted mt-3">Selected file: @selectedFileName</div>
            }
        </div>
    </div>

    @if (parseResult != null)
    {
        <ImportMappingPanel Title="2. Map Employee Columns"
                            Mappings="mappingInputs"
                            TargetFields="EmployeesOnlyImportService.AllTargetFields"
                            RequiredTargetFields="EmployeesOnlyImportService.RequiredTargetFields"
                            IsWorking="isWorking"
                            ValidateButtonText="Validate Employees"
                            OnValidate="ValidateEmployees" />

        <div class="card mb-4">
            <div class="card-header bg-light">3. Preview Before Import</div>
            <div class="table-responsive">
                <table class="table table-striped table-sm mb-0">
                    <thead>
                        <tr>
                            @foreach (var column in parseResult.Columns)
                            {
                                <th>@column</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in parseResult.Rows.Take(15))
                        {
                            <tr>
                                @foreach (var column in parseResult.Columns)
                                {
                                    <td>@GetCell(row, column)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer small text-muted">
                Preview shows up to 15 rows. Review data before confirming import.
            </div>
        </div>
    }

    @if (validationResult != null)
    {
        <div class="card mb-4">
            <div class="card-header bg-light">4. Validation Results</div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Batch</dt>
                    <dd class="col-sm-9">#@validationResult.Batch.ImportBatchId</dd>
                    <dt class="col-sm-3">Rows</dt>
                    <dd class="col-sm-9">@validationResult.Batch.RowCount total, @validationResult.Batch.ValidRowCount valid, @validationResult.Batch.ErrorCount errors</dd>
                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">@validationResult.Batch.Status</dd>
                </dl>

                @if (validationResult.Batch.Errors.Any())
                {
                    <div class="alert alert-danger">Validation errors must be resolved before employees can be imported.</div>
                    <ul>
                        @foreach (var error in validationResult.Batch.Errors.OrderBy(error => error.RowNumber).ThenBy(error => error.ErrorCode).Take(50))
                        {
                            <li>Row @(error.RowNumber?.ToString() ?? "batch"): @ImportFieldAliasMatcher.SanitizeErrorMessage(error.Message)</li>
                        }
                    </ul>
                }
                else
                {
                    <div class="alert alert-success">Validation completed. Employee records are ready for local import.</div>
                    <button class="btn btn-success" @onclick="ConfirmEmployees" disabled="@(isWorking || progress.IsWorking)">Confirm Employee Import</button>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<Company> companies = new();
    private int selectedCompanyId;
    private ImportFileParseResult? parseResult;
    private EmployeesOnlyImportValidationResult? validationResult;
    private List<ImportMappingInput> mappingInputs = new();
    private string selectedFileName = string.Empty;
    private string statusMessage = string.Empty;
    private string statusClass = "alert-info";
    private bool demoWarningAcknowledged;
    private bool isWorking;
    private ImportProgressModel progress = new();

    protected override async Task OnInitializedAsync()
    {
        companies = await CompanyService.GetAllActiveCompaniesAsync();
        if (companies.Count == 1)
        {
            selectedCompanyId = companies[0].CompanyId;
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs args)
    {
        ResetStatus();
        validationResult = null;
        selectedFileName = args.File.Name;

        try
        {
            isWorking = true;
            progress.MoveTo(ImportProgressStage.ReadingFile, "Reading the selected employee file.");
            await using var stream = args.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            progress.MoveTo(ImportProgressStage.ParsingRows, "Parsing employee rows locally.");
            parseResult = await EmployeeImportService.ParseFileAsync(stream, args.File.Name);
            progress.MoveTo(ImportProgressStage.DetectingColumns, "Detecting employee columns.", parseResult.Rows.Count, parseResult.Warnings.Count, 0);
            mappingInputs = parseResult.Columns
                .Select(column => new ImportMappingInput
                {
                    SourceColumn = column,
                    TargetField = ImportFieldAliasMatcher.SuggestTargetField(column, EmployeesOnlyImportService.AllTargetFields),
                    IsRequired = EmployeesOnlyImportService.RequiredTargetFields.Contains(ImportFieldAliasMatcher.SuggestTargetField(column, EmployeesOnlyImportService.AllTargetFields), StringComparer.OrdinalIgnoreCase)
                })
                .ToList();
            progress.MoveTo(ImportProgressStage.MappingColumns, "Review suggested employee mappings.", parseResult.Rows.Count, parseResult.Warnings.Count, 0);
            statusClass = "alert-success";
            statusMessage = "Employee file parsed locally. Review mappings and preview before validation.";
        }
        catch (Exception ex)
        {
            parseResult = null;
            mappingInputs.Clear();
            statusClass = "alert-danger";
            statusMessage = $"Unable to parse employee file: {ImportFieldAliasMatcher.SanitizeErrorMessage(ex.Message)}";
            progress.MoveTo(ImportProgressStage.Failed, "The employee file could not be parsed locally.", errorCount: 1);
        }
        finally
        {
            isWorking = false;
        }
    }

    private async Task ValidateEmployees()
    {
        if (parseResult == null)
        {
            return;
        }

        ResetStatus();

        try
        {
            isWorking = true;
            progress.MoveTo(ImportProgressStage.ValidatingRows, "Validating employee rows locally.", parseResult.Rows.Count);
            validationResult = await EmployeeImportService.ValidateAsync(
                selectedCompanyId,
                selectedFileName,
                parseResult,
                mappingInputs,
                demoWarningAcknowledged);
            statusClass = validationResult.CanImport ? "alert-success" : "alert-warning";
            statusMessage = validationResult.CanImport
                ? "Employees validated locally. Confirm import when the preview is acceptable."
                : "Employee validation found blocking errors.";
            progress.MoveTo(
                validationResult.CanImport ? ImportProgressStage.PreviewReady : ImportProgressStage.Failed,
                validationResult.CanImport ? "Preview is ready for final review." : "Validation found employee import errors.",
                validationResult.Batch.RowCount,
                0,
                validationResult.Batch.ErrorCount);
        }
        catch (Exception ex)
        {
            statusClass = "alert-danger";
            statusMessage = $"Unable to validate employees: {ImportFieldAliasMatcher.SanitizeErrorMessage(ex.Message)}";
            progress.MoveTo(ImportProgressStage.Failed, "Employee validation failed with a safe summary message.", errorCount: 1);
        }
        finally
        {
            isWorking = false;
        }
    }

    private async Task ConfirmEmployees()
    {
        if (validationResult == null)
        {
            return;
        }

        ResetStatus();

        try
        {
            isWorking = true;
            progress.MoveTo(ImportProgressStage.SavingImport, "Saving confirmed employee records locally.", validationResult.Batch.RowCount, 0, validationResult.Batch.ErrorCount);
            var result = await EmployeeImportService.ConfirmAsync(selectedCompanyId, validationResult.Batch.ImportBatchId);
            validationResult = new EmployeesOnlyImportValidationResult
            {
                Batch = result.Batch,
                CanImport = false
            };
            statusClass = "alert-success";
            statusMessage = $"{result.ImportedEmployeeCount} employee records imported into the local database.";
            progress.MoveTo(ImportProgressStage.Complete, "Employee import saved locally.", result.Batch.RowCount, 0, 0);
        }
        catch (Exception ex)
        {
            statusClass = "alert-danger";
            statusMessage = $"Unable to confirm employee import: {ImportFieldAliasMatcher.SanitizeErrorMessage(ex.Message)}";
            progress.MoveTo(ImportProgressStage.Failed, "Saving employee import failed.", errorCount: 1);
        }
        finally
        {
            isWorking = false;
        }
    }

    private static string GetCell(Dictionary<string, string> row, string column)
    {
        return row.TryGetValue(column, out var value) ? value : string.Empty;
    }

    private void ResetStatus()
    {
        statusMessage = string.Empty;
        statusClass = "alert-info";
    }
}
