@page "/setup/company"
@page "/setup/company/{CompanyId:int}"
@using ClearPathPayroll.Domain
@using ClearPathPayroll.Services
@using System.ComponentModel.DataAnnotations
@inject CompanyService CompanyService
@inject NavigationManager NavigationManager

<PageTitle>Company Setup - ClearPath Payroll</PageTitle>

<div class="container-fluid mt-4">
    <div class="row mb-4">
        <div class="col-md-8">
            <h2>Company Setup</h2>
            <p class="text-muted">@(isEditMode ? "Edit company information" : "Create a new company")</p>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (!string.IsNullOrEmpty(successMessage))
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> @successMessage
            <button type="button" class="btn-close" @onclick="() => successMessage = string.Empty"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Error!</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    <!-- Compliance Disclaimer -->
    <div class="alert alert-info" role="alert">
        <strong>Important Disclaimer:</strong> ClearPath Payroll stores user-entered employer setup details locally for demo review. It does not provide legal, tax, financial, accounting, payroll compliance, or licensed professional advice.
    </div>

    <!-- Loading State -->
    @if (isLoading && isEditMode)
    {
        <div class="alert alert-info">Loading company information...</div>
    }
    else
    {
        <!-- Form -->
        <EditForm Model="company" OnValidSubmit="HandleSaveAsync" class="needs-validation">
            <DataAnnotationsValidator />

            <div class="card">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Company Information</h5>
                </div>
                <div class="card-body">
                    <!-- Legal Name -->
                    <div class="mb-3">
                        <label for="legalName" class="form-label">Legal Name <span class="text-danger">*</span></label>
                        <InputText id="legalName" @bind-Value="company.LegalName" class="form-control" placeholder="Official legal name of the company" />
                        <ValidationMessage For="@(() => company.LegalName)" class="text-danger" />
                    </div>

                    <!-- DBA Name -->
                    <div class="mb-3">
                        <label for="dbaName" class="form-label">DBA Name (Doing Business As)</label>
                        <InputText id="dbaName" @bind-Value="company.DBAName" class="form-control" placeholder="Trade name if different from legal name" />
                        <ValidationMessage For="@(() => company.DBAName)" class="text-danger" />
                    </div>

                    <!-- FEIN -->
                    <div class="mb-3">
                        <label for="fein" class="form-label">Federal Employer Identification Number (FEIN) <span class="text-danger">*</span></label>
                        <InputText id="fein" @bind-Value="feinInput" class="form-control" placeholder="XX-XXXXXXX" maxlength="10" />
                        <small class="form-text text-muted">Example format: 12-3456789. This is user-entered tax ID data.</small>
                        <ValidationMessage For="@(() => company.FEIN)" class="text-danger" />
                    </div>
                </div>
            </div>

            <!-- Address Section -->
            <div class="card mt-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Address Information</h5>
                </div>
                <div class="card-body">
                    <!-- Street Address -->
                    <div class="mb-3">
                        <label for="address" class="form-label">Street Address <span class="text-danger">*</span></label>
                        <InputText id="address" @bind-Value="company.PrimaryAddress" class="form-control" placeholder="Street address" />
                        <ValidationMessage For="@(() => company.PrimaryAddress)" class="text-danger" />
                    </div>

                    <!-- City -->
                    <div class="mb-3">
                        <label for="city" class="form-label">City <span class="text-danger">*</span></label>
                        <InputText id="city" @bind-Value="company.City" class="form-control" placeholder="City" />
                        <ValidationMessage For="@(() => company.City)" class="text-danger" />
                    </div>

                    <!-- State & ZIP -->
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label for="state" class="form-label">State <span class="text-danger">*</span></label>
                            <InputText id="state" @bind-Value="company.State" class="form-control" placeholder="State code (e.g., OK)" maxlength="2" />
                            <small class="form-text text-muted">2-letter state code</small>
                            <ValidationMessage For="@(() => company.State)" class="text-danger" />
                        </div>
                        <div class="col-md-8 mb-3">
                            <label for="zip" class="form-label">ZIP Code <span class="text-danger">*</span></label>
                            <InputText id="zip" @bind-Value="company.ZipCode" class="form-control" placeholder="ZIP code" maxlength="10" />
                            <ValidationMessage For="@(() => company.ZipCode)" class="text-danger" />
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contact Section -->
            <div class="card mt-3">
                <div class="card-header bg-light">
                    <h5 class="mb-0">Contact Information</h5>
                </div>
                <div class="card-body">
                    <!-- Phone -->
                    <div class="mb-3">
                        <label for="phone" class="form-label">Phone Number</label>
                        <InputText id="phone" type="tel" @bind-Value="company.Phone" class="form-control" placeholder="(XXX) XXX-XXXX" @onblur="FormatPhone" />
                        <ValidationMessage For="@(() => company.Phone)" class="text-danger" />
                    </div>

                    <!-- Email -->
                    <div class="mb-3">
                        <label for="email" class="form-label">Email Address</label>
                        <InputText id="email" type="email" @bind-Value="company.Email" class="form-control" placeholder="company@example.com" />
                        <ValidationMessage For="@(() => company.Email)" class="text-danger" />
                    </div>

                    <!-- Payroll Contact Name -->
                    <div class="mb-3">
                        <label for="payrollContact" class="form-label">Payroll Contact Name</label>
                        <InputText id="payrollContact" @bind-Value="company.PayrollContactName" class="form-control" placeholder="Name of primary payroll contact" />
                        <ValidationMessage For="@(() => company.PayrollContactName)" class="text-danger" />
                    </div>
                </div>
            </div>

            <!-- Display Saved FEIN for Existing Company -->
            @if (isEditMode && !string.IsNullOrEmpty(company.FEIN))
            {
                <div class="alert alert-secondary mt-3" role="alert">
                    <strong>Saved FEIN:</strong> <code>@company.FEIN</code>
                </div>
            }

            <!-- Action Buttons -->
            <div class="mt-4 mb-4">
                <button type="submit" class="btn btn-primary me-2" disabled="@isSubmitting">
                    @if (isSubmitting)
                    {
                        <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                        <span>Saving...</span>
                    }
                    else
                    {
                        <span>Save Company</span>
                    }
                </button>
                <button type="button" class="btn btn-secondary" @onclick="HandleCancelAsync" disabled="@isSubmitting">
                    Cancel
                </button>
            </div>
        </EditForm>
    }
</div>

@code {
    [Parameter]
    public int? CompanyId { get; set; }

    private Company company = new();
    private string feinInput = string.Empty;
    private bool isEditMode = false;
    private bool isLoading = false;
    private bool isSubmitting = false;
    private string successMessage = string.Empty;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        if (CompanyId.HasValue && CompanyId.Value > 0)
        {
            isEditMode = true;
            await LoadCompanyAsync();
        }
        else
        {
            company = new Company
            {
                IsActive = true,
                CreatedAt = DateTime.UtcNow
            };
        }
    }

    private async Task LoadCompanyAsync()
    {
        isLoading = true;
        errorMessage = string.Empty;

        try
        {
            var loadedCompany = await CompanyService.GetCompanyByIdAsync(CompanyId.GetValueOrDefault());
            if (loadedCompany != null)
            {
                company = loadedCompany;
                feinInput = company.FEIN;
            }
            else
            {
                errorMessage = "Company not found.";
                isEditMode = false;
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error loading company: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task HandleSaveAsync()
    {
        if (!ValidateForm())
        {
            errorMessage = "Please correct the validation errors above.";
            return;
        }

        isSubmitting = true;
        errorMessage = string.Empty;
        successMessage = string.Empty;

        try
        {
            company.FEIN = CompanyService.FormatFEIN(feinInput);

            if (isEditMode)
            {
                var success = await CompanyService.UpdateCompanyAsync(company);
                if (success)
                {
                    successMessage = $"Company '{company.LegalName}' has been updated successfully.";
                    await Task.Delay(1500); // Brief delay to show success message
                    NavigationManager.NavigateTo("/");
                }
                else
                {
                    errorMessage = "Failed to update company. Please try again.";
                }
            }
            else
            {
                var createdCompany = await CompanyService.CreateCompanyAsync(company);
                successMessage = $"Company '{createdCompany.LegalName}' has been created successfully.";
                await Task.Delay(1500); // Brief delay to show success message
                NavigationManager.NavigateTo("/");
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error saving company: {ex.Message}";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private async Task HandleCancelAsync()
    {
        await Task.CompletedTask;
        NavigationManager.NavigateTo("/");
    }

    private void FormatPhone()
    {
        if (PhoneNumberFormatter.TryFormat(company.Phone, out var formatted, out _))
        {
            company.Phone = formatted;
        }
    }

    private bool ValidateForm()
    {
        // Basic client-side validation before submission
        if (string.IsNullOrWhiteSpace(company.LegalName))
        {
            errorMessage = "Legal name is required.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(feinInput))
        {
            errorMessage = "FEIN is required.";
            return false;
        }

        if (new string(feinInput.Where(char.IsDigit).ToArray()).Length != 9)
        {
            errorMessage = "FEIN must be 9 digits.";
            return false;
        }

        if (!PhoneNumberFormatter.TryFormat(company.Phone, out var formattedPhone, out var phoneError))
        {
            errorMessage = phoneError ?? "Phone number is invalid.";
            return false;
        }

        company.Phone = formattedPhone;

        if (string.IsNullOrWhiteSpace(company.PrimaryAddress))
        {
            errorMessage = "Street address is required.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(company.City))
        {
            errorMessage = "City is required.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(company.State) || company.State.Length != 2)
        {
            errorMessage = "State code must be 2 letters.";
            return false;
        }

        if (string.IsNullOrWhiteSpace(company.ZipCode))
        {
            errorMessage = "ZIP code is required.";
            return false;
        }

        return true;
    }
}
