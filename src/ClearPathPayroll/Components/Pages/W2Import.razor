@page "/import/w2"
@using ClearPathPayroll.Services
@inject W2ImportService W2ImportService

<PageTitle>W-2 Spreadsheet Import - ClearPath Payroll</PageTitle>

<div class="container-fluid mt-4">
    <NoAdviceDisclaimer />

    <div class="alert alert-success" role="status">
        <strong>Local import:</strong> W-2 spreadsheet files are parsed locally and saved only after confirmation. This workflow does not OCR PDF forms, create tax filings, transmit data externally, or validate W-2 correctness.
    </div>

    <div class="alert alert-warning" role="alert">
        Imported W-2 records are marked as “historical user-entered data.” Use EmployeeSSNLast4 only; full SSNs are not accepted.
    </div>

    <div class="card mb-4">
        <div class="card-header bg-light">W-2 Spreadsheet Columns</div>
        <div class="card-body">
            <p class="mb-2"><strong>Required:</strong> TaxYear, EmployerName, EmployerEIN, EmployerAddress, EmployeeFirstName, EmployeeLastName, EmployeeSSNLast4, EmployeeAddress, Box1Wages, Box2FederalTaxWithheld, Box3SocialSecurityWages, Box4SocialSecurityTaxWithheld, Box5MedicareWages, Box6MedicareTaxWithheld.</p>
            <p class="mb-0"><strong>Optional:</strong> Box12CodeAndAmount, Box14DescriptionAndAmount, StateWages, StateTaxWithheld, LocalWages, LocalTaxWithheld.</p>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-lg-8">
            <h2>W-2 Spreadsheet Import</h2>
            <p class="text-muted">Import user-provided W-2 spreadsheet rows for historical setup and review.</p>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(statusMessage))
    {
        <div class="alert @statusClass" role="status">@statusMessage</div>
    }

    <div class="card mb-4">
        <div class="card-header bg-light">1. Select Local Spreadsheet</div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-7">
                    <label class="form-label" for="w2File">W-2 spreadsheet file</label>
                    <InputFile id="w2File" class="form-control" OnChange="OnFileSelected" />
                    <div class="form-text">Accepted formats: .csv, .txt, .tsv, .tab, and first worksheet of .xlsx. PDF/OCR import is not included in this version.</div>
                </div>
                <div class="col-md-5">
                    <label class="form-check mt-4">
                        <input class="form-check-input" type="checkbox" @bind="reviewAcknowledged" />
                        Review warning acknowledged
                    </label>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(selectedFileName))
            {
                <div class="small text-muted mt-3">Selected file: @selectedFileName</div>
            }
        </div>
    </div>

    @if (parseResult != null)
    {
        <div class="card mb-4">
            <div class="card-header bg-light">2. Map Columns</div>
            <div class="card-body">
                @foreach (var warning in parseResult.Warnings)
                {
                    <div class="alert alert-warning">@warning</div>
                }

                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Source column</th>
                                <th>W-2 field</th>
                                <th>Required by mapping</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var mapping in mappingInputs)
                            {
                                <tr>
                                    <td>@mapping.SourceColumn</td>
                                    <td>
                                        <select class="form-select form-select-sm" @bind="mapping.TargetField">
                                            <option value="">Do not import</option>
                                            @foreach (var field in W2ImportService.AllTargetFields)
                                            {
                                                <option value="@field">@field</option>
                                            }
                                        </select>
                                    </td>
                                    <td><input class="form-check-input" type="checkbox" @bind="mapping.IsRequired" /></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <button class="btn btn-primary" @onclick="ValidateW2Rows" disabled="@isWorking">Validate W-2 Rows</button>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-light">3. Preview Before Saving</div>
            <div class="table-responsive">
                <table class="table table-striped table-sm mb-0">
                    <thead>
                        <tr>
                            @foreach (var column in parseResult.Columns)
                            {
                                <th>@column</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in parseResult.Rows.Take(15))
                        {
                            <tr>
                                @foreach (var column in parseResult.Columns)
                                {
                                    <td>@GetCell(row, column)</td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer small text-muted">Preview shows up to 15 rows. Records are saved only after confirmation.</div>
        </div>
    }

    @if (validationResult != null)
    {
        <div class="card mb-4">
            <div class="card-header bg-light">4. Validation Results</div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-3">Batch</dt>
                    <dd class="col-sm-9">#@validationResult.Batch.ImportBatchId</dd>
                    <dt class="col-sm-3">Rows</dt>
                    <dd class="col-sm-9">@validationResult.Batch.RowCount total, @validationResult.Batch.ValidRowCount valid, @validationResult.Batch.ErrorCount errors</dd>
                    <dt class="col-sm-3">Status</dt>
                    <dd class="col-sm-9">@validationResult.Batch.Status</dd>
                </dl>

                @if (validationResult.Batch.Errors.Any())
                {
                    <div class="alert alert-danger">Validation errors require review before saving W-2 historical records.</div>
                    <ul>
                        @foreach (var error in validationResult.Batch.Errors.OrderBy(error => error.RowNumber).ThenBy(error => error.ErrorCode).Take(50))
                        {
                            <li>Row @(error.RowNumber?.ToString() ?? "batch"): @error.Message</li>
                        }
                    </ul>
                }
                else
                {
                    <div class="alert alert-success">Validation completed. W-2 records are ready to save as historical user-entered data.</div>
                    <button class="btn btn-success" @onclick="ConfirmW2Rows" disabled="@isWorking">Save Historical W-2 Records</button>
                }
            </div>
        </div>
    }
</div>

@code {
    private ImportFileParseResult? parseResult;
    private W2ImportValidationResult? validationResult;
    private List<ImportMappingInput> mappingInputs = new();
    private string selectedFileName = string.Empty;
    private string statusMessage = string.Empty;
    private string statusClass = "alert-info";
    private bool reviewAcknowledged;
    private bool isWorking;

    private async Task OnFileSelected(InputFileChangeEventArgs args)
    {
        ResetStatus();
        validationResult = null;
        selectedFileName = args.File.Name;

        try
        {
            isWorking = true;
            await using var stream = args.File.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            parseResult = await W2ImportService.ParseFileAsync(stream, args.File.Name);
            mappingInputs = parseResult.Columns.Select(column =>
            {
                var target = GuessW2Field(column);
                return new ImportMappingInput
                {
                    SourceColumn = column,
                    TargetField = target,
                    IsRequired = W2ImportService.RequiredTargetFields.Contains(target, StringComparer.OrdinalIgnoreCase)
                };
            }).ToList();
            statusClass = "alert-success";
            statusMessage = "W-2 spreadsheet parsed locally. Review mappings and preview before validation.";
        }
        catch (Exception ex)
        {
            parseResult = null;
            mappingInputs.Clear();
            statusClass = "alert-danger";
            statusMessage = $"Unable to parse W-2 spreadsheet: {ex.Message}";
        }
        finally
        {
            isWorking = false;
        }
    }

    private async Task ValidateW2Rows()
    {
        if (parseResult == null)
        {
            return;
        }

        ResetStatus();

        try
        {
            isWorking = true;
            validationResult = await W2ImportService.ValidateAsync(
                selectedFileName,
                parseResult,
                mappingInputs,
                reviewAcknowledged);
            statusClass = validationResult.CanImport ? "alert-success" : "alert-warning";
            statusMessage = validationResult.CanImport
                ? "W-2 rows validated locally. Save records after review."
                : "W-2 validation found blocking errors.";
        }
        catch (Exception ex)
        {
            statusClass = "alert-danger";
            statusMessage = $"Unable to validate W-2 rows: {ex.Message}";
        }
        finally
        {
            isWorking = false;
        }
    }

    private async Task ConfirmW2Rows()
    {
        if (validationResult == null)
        {
            return;
        }

        ResetStatus();

        try
        {
            isWorking = true;
            var result = await W2ImportService.ConfirmAsync(validationResult.Batch.ImportBatchId);
            validationResult = new W2ImportValidationResult { Batch = result.Batch };
            statusClass = "alert-success";
            statusMessage = $"{result.ImportedRecordCount} historical user-entered W-2 record(s) saved locally.";
        }
        catch (Exception ex)
        {
            statusClass = "alert-danger";
            statusMessage = $"Unable to save W-2 records: {ex.Message}";
        }
        finally
        {
            isWorking = false;
        }
    }

    private static string GetCell(Dictionary<string, string> row, string column)
    {
        return row.TryGetValue(column, out var value) ? value : string.Empty;
    }

    private static string GuessW2Field(string column)
    {
        var normalized = column.Replace(" ", string.Empty, StringComparison.OrdinalIgnoreCase)
            .Replace("_", string.Empty, StringComparison.OrdinalIgnoreCase)
            .Replace("-", string.Empty, StringComparison.OrdinalIgnoreCase)
            .Replace(".", string.Empty, StringComparison.OrdinalIgnoreCase);

        return W2ImportService.AllTargetFields.FirstOrDefault(field =>
            string.Equals(field, normalized, StringComparison.OrdinalIgnoreCase))
            ?? string.Empty;
    }

    private void ResetStatus()
    {
        statusMessage = string.Empty;
        statusClass = "alert-info";
    }
}
