@page "/reports/tax-liability"
@using ClearPathPayroll.Domain
@using ClearPathPayroll.Services
@inject TaxLiabilityReportService TaxLiabilityReportService

<PageTitle>Tax Liability Report</PageTitle>

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1>Tax Liability Report</h1>
            <p class="text-muted">Review payroll run tax liabilities by tax type, including employee withholding and employer tax totals.</p>
        </div>
        <div>
            <a class="btn btn-outline-secondary me-2" href="/">Back to home</a>
            @if (string.IsNullOrEmpty(csvDownloadUri))
            {
                <button class="btn btn-primary" disabled>Export CSV</button>
            }
            else
            {
                <a class="btn btn-primary" href="@csvDownloadUri" download="TaxLiabilityReport.csv">Export CSV</a>
            }
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">Report filters</h5>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">Company</label>
                    <select class="form-select" @bind="selectedCompanyId">
                        <option value="">All companies</option>
                        @foreach (var company in companies)
                        {
                            <option value="@company.CompanyId">@company.LegalName</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">Pay date from</label>
                    <input class="form-control" type="date" @bind="startDate" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Pay date to</label>
                    <input class="form-control" type="date" @bind="endDate" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button class="btn btn-primary w-100" @onclick="LoadReportAsync">Refresh</button>
                </div>
            </div>
        </div>
    </div>

    @if (isLoading)
    {
        <div class="text-center py-5">
            <div class="spinner-border" role="status"></div>
            <p class="mt-3">Loading tax liability report...</p>
        </div>
    }
    else if (report == null || !report.Runs.Any())
    {
        <div class="alert alert-info">No payroll runs found for the selected filters.</div>
    }
    else
    {
        <div class="mb-3">
            <strong>Company:</strong> @report.CompanyName<br />
            <strong>Pay date range:</strong> @(report.PayDateStart?.ToString("MM/dd/yyyy") ?? "Any") - @(report.PayDateEnd?.ToString("MM/dd/yyyy") ?? "Any")
        </div>

        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Run ID</th>
                        <th>Company</th>
                        <th>Pay Date</th>
                        <th>Pay Period</th>
                        <th>Due Date</th>
                        <th>Payment Status</th>
                        <th>Employee Withholding</th>
                        <th>Employer Taxes</th>
                        <th>Total Liability</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var run in report.Runs)
                    {
                        <tr class="table-secondary">
                            <td>@run.PayrollRunId</td>
                            <td>@run.CompanyName</td>
                            <td>@run.PayDate.ToString("MM/dd/yyyy")</td>
                            <td>@run.PayPeriodStart.ToString("MM/dd/yyyy") - @run.PayPeriodEnd.ToString("MM/dd/yyyy")</td>
                            <td>@run.DueDatePlaceholder</td>
                            <td>@run.PaymentStatusPlaceholder</td>
                            <td>@run.TotalEmployeeWithholding.ToString("C")</td>
                            <td>@run.TotalEmployerTaxes.ToString("C")</td>
                            <td>@run.TotalTaxLiability.ToString("C")</td>
                        </tr>
                        <tr>
                            <td colspan="9" class="p-0">
                                <div class="table-responsive">
                                    <table class="table table-sm mb-0">
                                        <thead>
                                            <tr class="table-light">
                                                <th>Liability Type</th>
                                                <th>Tax Type</th>
                                                <th class="text-end">Amount</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var group in run.EmployeeWithholdingGroups)
                                            {
                                                <tr>
                                                    <td>Employee Withholding</td>
                                                    <td>@group.TaxType</td>
                                                    <td class="text-end">@group.Amount.ToString("C")</td>
                                                </tr>
                                            }
                                            @foreach (var group in run.EmployerTaxGroups)
                                            {
                                                <tr>
                                                    <td>Employer Tax</td>
                                                    <td>@group.TaxType</td>
                                                    <td class="text-end">@group.Amount.ToString("C")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot class="table-secondary">
                    <tr>
                        <th colspan="6">Totals</th>
                        <th>@report.TotalEmployeeWithholding.ToString("C")</th>
                        <th>@report.TotalEmployerTaxes.ToString("C")</th>
                        <th>@report.TotalTaxLiability.ToString("C")</th>
                    </tr>
                </tfoot>
            </table>
        </div>
    }
</div>

@code {
    private bool isLoading;
    private TaxLiabilityReportModel? report;
    private List<Company> companies = new();
    private int? selectedCompanyId;
    private DateTime? startDate = DateTime.Today.AddDays(-30);
    private DateTime? endDate = DateTime.Today;
    private string csvDownloadUri = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        companies = await TaxLiabilityReportService.GetAvailableCompaniesAsync();
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        isLoading = true;
        report = await TaxLiabilityReportService.GetTaxLiabilityReportAsync(selectedCompanyId, startDate, endDate);
        csvDownloadUri = BuildCsvUri(report);
        isLoading = false;
    }

    private string BuildCsvUri(TaxLiabilityReportModel reportModel)
    {
        if (reportModel == null || reportModel.Runs == null || !reportModel.Runs.Any())
        {
            return string.Empty;
        }

        var csv = TaxLiabilityReportService.BuildTaxLiabilityCsv(reportModel);
        var bytes = System.Text.Encoding.UTF8.GetBytes(csv);
        var base64 = Convert.ToBase64String(bytes);
        return $"data:text/csv;base64,{base64}";
    }
}
